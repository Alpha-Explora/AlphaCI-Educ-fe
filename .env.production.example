# =============================================================================
# AlphaCI-Educ frontend — PRODUCTION environment template
#
# On Vercel these go in Project Settings -> Environment Variables. There is
# exactly one variable, and two things about it that bite.
# =============================================================================

# The backend's PUBLIC base URL, including the /api prefix the API is served
# under. No trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://api.example.edu/api

# 1. NEXT_PUBLIC_* is inlined into the JavaScript bundle AT BUILD TIME. Changing
#    it in the Vercel dashboard does nothing to an already-built deployment —
#    you must redeploy. If the app is calling localhost:4000 in production, this
#    is why: it was built before the variable existed.
#
# 2. Whatever host you put here must be listed in the backend's FRONTEND_URL (or
#    CORS_ORIGIN), and the two must agree about cookies. Every request is sent
#    with `credentials: "include"`; if the API is on a different registrable
#    domain than this app, the backend needs SESSION_SAME_SITE=none and staff
#    sign-in still will not work in Safari or Firefox. Putting both behind
#    subdomains of one domain avoids the whole problem — see the backend's
#    .env.production.example.
